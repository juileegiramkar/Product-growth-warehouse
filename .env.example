# Copy to .env (optional - these are the defaults)
PULSE_SIM_START=2026-08-21
PULSE_SEED=42
# Airflow web UI login (local only)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# false = the DAG starts and backfills 90 days as soon as Airflow is up
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=false
SPARK_DRIVER_MEMORY=2g
# optional alerting
PULSE_ALERT_EMAIL=
PULSE_SLACK_WEBHOOK=
# Host port for the Airflow UI
AIRFLOW_PORT=8080
